# Leave a value empty to turn that feature off. Keep comments on their own lines.

# ---- Reading query letters and documents (pick ONE; with none, the built-in rules engine is used)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- WhatsApp: Twilio sandbox (console.twilio.com > Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Or Meta WhatsApp Cloud API test number instead of Twilio:
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# ---- Email: Gmail with an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- Demo routing: send every patient message to the evaluator's test phone / email
# Example: WHATSAPP_OVERRIDE_TO=+919876543210
WHATSAPP_OVERRIDE_TO=
EMAIL_OVERRIDE_TO=

# ---- Public URL of this app (ngrok or Render). Needed for WhatsApp replies and read receipts.
# Example: PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# ---- App
SECRET_KEY=change-me-to-a-long-random-string
# Key for POST /api/patients/{id}/queries
INBOUND_API_KEY=
SUPPORT_PHONE=+91-80-0000-0000
DEFAULT_DEADLINE_DAYS=3
REMINDER_HOURS_BEFORE=24
